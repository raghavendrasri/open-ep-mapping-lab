# How to cite Open EP Mapping Lab. GitHub shows this as "Cite this repository" on the repository page.
# The same citation is on the site's About page (about.qmd, "How to cite"); tests/test_citation.py keeps them in step.
cff-version: 1.2.0
message: "If you use this course, please cite it as below."
type: software
title: "Open EP Mapping Lab: an open course on cardiac electroanatomic mapping systems"
abstract: >-
  A free, open, interactive course on how cardiac electroanatomic mapping systems localize catheters, record and
  process electrograms, and build activation and voltage maps. Education only; not for clinical use.
authors:
  - name: "Open EP Mapping Lab contributors"
url: "https://openepengineering.org/"
repository-code: "https://github.com/raghavendrasri/open-ep-mapping-lab"
license:
  - CC-BY-4.0
  - MIT
keywords:
  - cardiac electrophysiology
  - electroanatomic mapping
  - electrograms
  - education
preferred-citation:
  type: generic
  title: "Open EP Mapping Lab: an open course on cardiac electroanatomic mapping systems"
  authors:
    - name: "Open EP Mapping Lab contributors"
  year: 2026
  url: "https://openepengineering.org/"
  medium: "Website"
